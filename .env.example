# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_TIMEZONE=UTC

# PostgreSQL (example values only; do not reuse in production)
POSTGRES_DB=trendsignal
POSTGRES_USER=trendsignal
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://trendsignal:change-me@localhost:5432/trendsignal

# External providers
YOUTUBE_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Collection defaults (activated in a later phase)
COLLECTION_TIMEZONE=UTC
COLLECTION_INTERVAL_MINUTES=60
COLLECTOR_REQUEST_TIMEOUT_SECONDS=30
COLLECTOR_MAX_RETRIES=3

# Data provenance: REAL in connected environments, FIXTURE/MOCK only in tests or demos
DEFAULT_DATA_KIND=REAL
